# YOLOv8 推理配置

# 推理模式
USE_CPU=false           # true: CPU 推理；false: GPU (TensorRT) 推理

# 模型与数据路径
MODEL_PATH=./yolov8-obb-finetune-best-batch8.onnx
INPUT_IMAGE_PATH=./data/GF2_PMS1_E118.6_N37.4_20160826_L1A0001792619-MSS1-fusion.dat
OUTPUT_IMAGE_PATH=./output_yolov8s_finetune_best_class/output.jpg

# 推理参数
BATCH_SIZE=8            # 批量推理大小（与模型编译时的 batch size 必须一致）
SAVE_WORKERS=4          # 异步保存 worker 数量

# 输出控制
DRAW_LABELS=false       # 是否在检测框上绘制标签
VERBOSE_DETECTIONS=false # 是否输出逐框日志
JPEG_QUALITY=90         # 输出图像 JPEG 质量（1-100）

# 类别过滤（留空表示检测全部类别）
# 可用 ID（0-7）或名称，逗号分隔
# 类别列表: 0=oil, 1=bridge, 2=basketball court, 3=ground track field,
#           4=roundabout, 5=harbor, 6=other court, 7=soccer ball field
CLASSES=
